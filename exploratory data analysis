-- EXPLORATORY DATA ANALYSIS

-- Here, we will explore the data to look for patterns or trends
SELECT *
FROM layoffs_staging3;

SELECT MAX(total_laid_off), MAX(percentage_laid_off)
FROM layoffs_staging3;

-- We look at these percentages to see how huge these layoffs were 
SELECT MAX(percentage_laid_off), MIN(percentage_laid_off)
FROM layoffs_staging3
WHERE percentage_laid_off IS NOT NULL;

SELECT *
FROM layoffs_staging3
WHERE percentage_laid_off = 1
ORDER BY total_laid_off DESC;

-- We order them by funds_raised_millions to see how big these companies actually are, to help make sense with the layoffs
SELECT *
FROM layoffs_staging3
WHERE percentage_laid_off = 1
ORDER BY funds_raised_millions DESC;

-- With the given data, the total_laid_off is the most interesting to look at.
-- Although the total no. of employees is not in the given data, we can solve this using the given total_laid_off and percentage_laid_off
-- However, it is hard to make sense of it because these layoff data were dependent on dates, as well as industry. there are entries that has repeating companies due to the date of these layoffs.
SELECT industry, SUM(total_laid_off)
FROM layoffs_staging3
GROUP BY industry
ORDER BY 2 DESC;

SELECT company, SUM(total_laid_off)
FROM layoffs_staging3
GROUP BY company
ORDER BY 2 DESC;

SELECT country, SUM(total_laid_off)
FROM layoffs_staging3
GROUP BY country
ORDER BY 2 DESC;

SELECT `date`, SUM(total_laid_off)
FROM layoffs_staging3
GROUP BY `date`
ORDER BY 1 DESC;

-- Since it is harder to look at just the dates itself, we group these layoffs by year for easier visualization
SELECT YEAR(`date`), SUM(total_laid_off)
FROM layoffs_staging3
GROUP BY YEAR(`date`)
ORDER BY 1 DESC;

-- In this part, we will explore the rolling sum of layoffs
-- Firstly, we wil look at the total layoffs per month
SELECT SUBSTRING(`date`,6,2) AS `MONTH`, SUM(total_laid_off)
FROM layoffs_staging3
GROUP BY `MONTH`;

-- Here, we will look at total layoffs per month, this time, considering its year
SELECT SUBSTRING(`date`,1,7) AS `MONTH`, SUM(total_laid_off)
FROM layoffs_staging3
WHERE SUBSTRING(`date`,1,7) IS NOT NULL
GROUP BY `MONTH`
ORDER BY 1 ASC;

-- Now, we create a rolling total for this, we use CTE
WITH Rolling_Total AS
(
SELECT SUBSTRING(`date`,1,7) AS `MONTH`, SUM(total_laid_off) AS total_off
FROM layoffs_staging3
WHERE SUBSTRING(`date`,1,7) IS NOT NULL
GROUP BY `MONTH`
ORDER BY 1 ASC
)
SELECT `MONTH`, total_off, SUM(total_off) OVER(ORDER BY `MONTH`) AS rolling_total
FROM Rolling_Total;

WITH Rolling_Total AS
(
SELECT country, SUM(total_laid_off) AS total_off
FROM layoffs_staging3
WHERE country IS NOT NULL
GROUP BY country
ORDER BY 1 ASC
)
SELECT country, total_off, SUM(total_off) OVER(ORDER BY country) AS rolling_total
FROM Rolling_Total;

-- Which companies had the highest total number of layoffs per year?
SELECT company, YEAR(`date`), SUM(total_laid_off)
FROM layoffs_staging3
GROUP BY company, YEAR(`date`)
ORDER BY 3 DESC;

-- Here, we create a summary of the top 5 companies with the highest total laid off from years 2020 to 2023
SELECT country, industry, SUM(total_laid_off)
FROM layoffs_staging3
GROUP BY country, industry
ORDER BY country, 1 DESC;

WITH Company_Year  (company, years, total_laid_off) AS
(
SELECT company, YEAR(`date`), SUM(total_laid_off)
FROM layoffs_staging3
GROUP BY company, YEAR(`date`)
),
Company_Year_Rank AS 
(
SELECT *, DENSE_RANK() OVER(PARTITION BY years ORDER BY total_laid_off DESC) AS `RANK`
FROM Company_Year
WHERE years IS NOT NULL
ORDER BY `RANK` ASC
)
SELECT *
FROM Company_Year_Rank
WHERE `RANK` <= 5
ORDER BY years;
